@model LoginModel

@inject DemoAccess DemoAccess

@{
    ViewData["Title"] = DemoAccess.IsEnabled ? "Experimente o iBudget" : "Login";
}

@if (!DemoAccess.IsEnabled)
{
<script type="application/javascript">
    $(document).ready(function() {
        setIpAddress();
    });

    function setIpAddress() {
        const ipAddress = $('#ipAddress');
        ipAddress.val(null);

        $.getJSON("https://api.ipify.org?format=jsonp&callback=?",
        function(json) {
            if (json.ip)
                ipAddress.val(json.ip);
        });
    }
</script>
}

@section Scripts
{
    @if (DemoAccess.IsEnabled)
    {
        <script src="~/js/demoLogin.js" defer asp-append-version="true"></script>
    }
}

<div class="container">
    <div class="row justify-content-center">
        <div class="@(DemoAccess.IsEnabled ? "col-12 col-md-8 col-lg-6" : "col-12 col-md-4")">

            @if (DemoAccess.IsEnabled)
            {
                <form asp-controller="Login" asp-action="Demo" method="post" id="formDemo"
                      class="demo-entry border rounded-4 shadow-sm p-4 p-md-5 my-4 my-md-5">
                    <h1 class="display-6 fw-semibold mb-3">Experimente o iBudget</h1>
                    <p id="demoDescription" class="lead mb-4">Monte um orçamento completo com clientes e itens de exemplo. Não precisa criar conta nem informar senha.</p>

                    <ul class="demo-entry__features mb-4 ps-4">
                        <li>Cadastre pessoas e itens</li>
                        <li>Crie e consulte orçamentos</li>
                        <li>Gere PDFs para compartilhamento</li>
                    </ul>

                    @if (ViewData["DemoError"] is string error)
                    {
                        <p id="demoError" class="alert alert-danger mb-4" role="alert">@error</p>
                    }

                    <button id="demoLoginButton" class="btn btn-primary btn-lg w-100 mb-4" type="submit"
                            aria-describedby="demoDescription demoNotice">Explorar demonstração</button>
                    <p id="demoLoginStatus" class="visually-hidden" role="status" aria-live="polite"></p>
                    <p id="demoNotice" class="demo-entry__notice small text-body-secondary border-top pt-3 mb-0">
                        <strong class="text-body">Ambiente compartilhado.</strong>
                        Os dados são reiniciados periodicamente. Use apenas informações fictícias.
                    </p>
                </form>
            }
            else
            {

            @using (Html.BeginForm("Login", "Login", FormMethod.Post, new { @class = "needs-validation", id = "formLogin" }))
            {
                <object class="svg svg-person mb-4" width="72" height="72" alt="Person"></object>
                <h1 class="h3 mb-3 font-weight-normal">Entrar</h1>

                <partial name="Partials/_EditLogin"/>

                <div class="form-check text-start my-3">
                    <label asp-for="Remember" class="form-check-label">
                        <input asp-for="Remember" class="form-check-input" type="checkbox">
                        Lembrar-me
                    </label>
                </div>

                <input type="hidden" id="ipAddress" name="IpAddress"/>

                <div id="submit" class="text-end mb-4">
                    <button class="btn btn-primary btn-lg" type="submit">Entrar</button>
                </div>
            }
            }
        </div>
    </div>
</div>
